{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "services/*/src",
    "services/*/test",
    "apps/*/src",
    "apps/*/test",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
