+.model-select{display:flex;align-items:center;gap:8px;background:var(--panel-2);border:1px solid var(--line);
+  border-radius:var(--r-pill);padding:5px 10px;font-size:12.5px}
+.model-select select{background:none;border:0;outline:0;color:var(--text)}
+.msgs{flex:1;padding:var(--s4);display:flex;flex-direction:column;gap:var(--s3);overflow:auto}
+.msg{display:flex;gap:10px;max-width:min(660px,86%)}
+.msg.me{align-self:flex-end;flex-direction:row-reverse}
+.bubble{background:var(--panel-2);border:1px solid var(--line);border-radius:var(--r-md);padding:10px 13px}
+.msg.me .bubble{background:var(--accent-soft)}
+.bubble .who2{font-size:11.5px;color:var(--faint);margin-bottom:4px;display:flex;gap:8px;align-items:center}
+.bubble p{margin:0}
+.bubble .att{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}
+.att .file{display:inline-flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);
+  border-radius:var(--r-sm);padding:6px 9px;font-size:12px;color:var(--muted)}
+.voice{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line);background:var(--panel);
+  border-radius:var(--r-pill);padding:6px 11px;font-size:12px}
+.wave{display:flex;align-items:center;gap:2px;height:14px}
+.wave i{width:2px;background:var(--accent);border-radius:2px}
+.composer{border-top:1px solid var(--line);padding:var(--s3);display:flex;gap:var(--s2);align-items:flex-end}
+.composer textarea{flex:1;resize:none;min-height:44px;max-height:140px;background:var(--panel-2);border:1px solid var(--line);
+  border-radius:var(--r-sm);padding:11px 13px;outline:0}
+.states{display:flex;gap:var(--s2);flex-wrap:wrap;padding:0 var(--s4) var(--s3)}
+.tiny{font-size:11.5px;color:var(--faint)}
+
+/* reserved network */
+.reserved{border:2px dashed var(--line);border-radius:var(--r-lg);min-height:440px;display:grid;place-items:center;
+  text-align:center;padding:var(--s6);background:
+    radial-gradient(600px 300px at 50% 0%, var(--accent-soft), transparent 70%)}
+.reserved .box{max-width:520px}
+.reserved h2{margin:0 0 var(--s2);font-size:18px}
+.reserved p{color:var(--muted);margin:0 0 var(--s3)}
+.hint{display:inline-flex;gap:8px;align-items:center;font-size:12px;color:var(--faint);border:1px solid var(--line);
+  border-radius:var(--r-pill);padding:5px 12px;background:var(--panel)}
+
+/* drawer */
+.drawer{position:fixed;inset-block:0;inset-inline-end:0;width:min(430px,92vw);background:var(--panel);
+  border-inline-start:1px solid var(--line);box-shadow:var(--shadow);transform:translateX(105%);transition:transform var(--t);z-index:40;
+  display:flex;flex-direction:column}
+[dir="rtl"] .drawer{transform:translateX(-105%)}
+.drawer.on{transform:none}
+.drawer-head{padding:var(--s4);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
+.drawer-body{padding:var(--s4);overflow:auto;display:flex;flex-direction:column;gap:var(--s4)}
+.tabs{display:flex;gap:var(--s1);border-bottom:1px solid var(--line);padding:0 var(--s4)}
+.tabs button{padding:11px 12px;color:var(--muted);border-bottom:2px solid transparent}
+.tabs button.on{color:var(--text);border-bottom-color:var(--accent)}
+.kv{display:grid;grid-template-columns:auto 1fr;gap:8px var(--s3);font-size:13px}
+.kv dt{color:var(--faint)}
+.kv dd{margin:0}
+.chips{display:flex;gap:6px;flex-wrap:wrap}
+.check{display:flex;gap:9px;align-items:flex-start;font-size:13px}
+.check input{margin-top:3px}
+.timeline{border-inline-start:1px solid var(--line);padding-inline-start:var(--s3);display:flex;flex-direction:column;gap:var(--s3)}
+.tl{position:relative;font-size:13px;color:var(--muted)}
+.tl::before{content:"";position:absolute;inset-inline-start:calc(-1 * var(--s3) - 4px);top:6px;width:7px;height:7px;border-radius:50%;background:var(--accent)}
+.tl b{color:var(--text)}
+
+/* coverage list */
+.cov{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--s2)}
+.cov div{display:flex;gap:9px;align-items:center;background:var(--panel-2);border:1px solid var(--line);
+  border-radius:var(--r-sm);padding:9px 11px;font-size:13px}
+.cov .yes{color:var(--ok)} .cov .no{color:var(--faint)}
+
+.switch{display:inline-flex;align-items:center;gap:8px}
+.seg{display:inline-flex;border:1px solid var(--line);border-radius:var(--r-pill);overflow:hidden;background:var(--panel-2)}
+.seg button{padding:6px 12px;font-size:12.5px;color:var(--muted)}
+.seg button.on{background:var(--accent-soft);color:var(--text)}
